# =============================================================================
# PhantomGuard - root .gitignore
# =============================================================================

# -- Dependencies -------------------------------------------------------------
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -- Build artifacts ----------------------------------------------------------
dist/
build/
out/
coverage/
.vite/
.cache/
.turbo/
.netlify/
*.tsbuildinfo

# -- Environment and secrets --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# -- Logs and debug output ----------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -- OS and editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# =============================================================================
# KIRO GOVERNANCE - MUST STAY TRACKED
# The Kiroween submission requires the /.kiro directory (specs, steering,
# hooks, settings) and every subfolder to be committed. The re-includes below
# come AFTER all other patterns because the last matching pattern wins, so no
# broad rule above (dist/, build/, out/, *.log, ...) can hide governance files.
# Do not add ignore rules for .kiro above this block.
# =============================================================================
!.kiro/
!.kiro/**

# Exception: credentials are never governance artifacts. These sit after the
# re-include so they win, and keep a stray secret in .kiro/ out of commits.
.kiro/**/.env
.kiro/**/.env.*
.kiro/**/*.pem
.kiro/**/*.key
