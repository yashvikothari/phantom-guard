{
  "name": "@phantomguard/cli-toolkit",
  "version": "0.1.0",
  "description": "The phantomguard command: scan Terraform, Dockerfiles and IAM policies from a terminal or CI, with pretty, JSON and SARIF output.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "phantomguard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:property": "vitest run --dir test --reporter=verbose"
  },
  "dependencies": {
    "@phantomguard/core-engine": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^4.0.0",
    "vitest": "^3.2.0"
  }
}
